<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- No model calls: the eval data audit, the checks and the harness with a scripted stub. `mvnw test` runs this. -->
<suite name="Unit">
    <test name="Eval data, checks and harness">
        <classes>
            <class name="com.niranjankagri.llmtesting.CaseSetTest"/>
            <class name="com.niranjankagri.llmtesting.ChecksTest"/>
            <class name="com.niranjankagri.llmtesting.HarnessTest"/>
        </classes>
    </test>
</suite>
